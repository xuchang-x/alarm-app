<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- 设备重启后重排闹钟 -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- Android 12+ 精确闹钟（未授权时降级为非精确触发） -->
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
  <!-- Android 13+ 闹钟类应用专用精确闹钟权限：系统自动授予，
       免去用户手动开启"闹钟和提醒"（否则新装用户闹钟会延迟数分钟触发） -->
  <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
  <!-- 响铃前台服务 -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <!-- 响铃通知全屏弹窗（Android 10+）：闹钟类 App 标准行为，息屏/锁屏时直接全屏拉起；
       权限受限时系统自动降级为 heads-up 横幅 -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

  <application>
    <receiver
      android:name="alarm.ring.AlarmReceiver"
      android:exported="false" />

    <receiver
      android:name="alarm.ring.BootReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>

    <service
      android:name="alarm.ring.RingService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback" />

    <!-- 响铃全屏界面：由 RingService 通知的 full-screen intent 拉起，
         showWhenLocked/turnScreenOn 盖锁屏 + 自动亮屏（低版本在代码里用 window flag 等价实现），
         excludeFromRecents 不进最近任务，不参与 App 返回栈 -->
    <activity
      android:name="alarm.ring.AlarmRingActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:showWhenLocked="true"
      android:turnScreenOn="true"
      android:theme="@style/RingActivityTheme" />
  </application>
</manifest>
