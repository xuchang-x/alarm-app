<?xml version="1.0" encoding="utf-8"?>
<!--
  响铃界面（AlarmRingActivity）：盖锁屏全屏展示，铃声由 RingService 前台服务承载。
  布局结构对齐 JS 侧 RingOverlay：居中卡片 = 铃铛徽标 + 闹钟标题 + 副文案
  + 「稍后提醒」「关闭」双按钮。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#66000000">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    android:background="@drawable/ring_card_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="28dp"
    android:paddingEnd="22dp"
    android:paddingBottom="22dp">

    <FrameLayout
      android:layout_width="72dp"
      android:layout_height="72dp"
      android:background="@drawable/ring_badge_bg">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="⏰"
        android:textSize="34sp" />
    </FrameLayout>

    <TextView
      android:id="@+id/ring_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:gravity="center"
      android:lineSpacingExtra="4dp"
      android:maxLines="2"
      android:textColor="@color/skinTextPrimary"
      android:textSize="20sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/ring_body"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:gravity="center"
      android:textColor="@color/skinTextSecondary"
      android:textSize="14sp" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/btn_snooze"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:background="@drawable/ring_btn_secondary_bg"
        android:gravity="center"
        android:textColor="@color/skinTextPrimary"
        android:textSize="15sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/btn_stop"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_weight="1"
        android:background="@drawable/ring_btn_primary_bg"
        android:gravity="center"
        android:textColor="@color/skinOnPrimary"
        android:textSize="15sp"
        android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
